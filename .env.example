# Copy to .env on the host. Do not commit .env. This process never holds a key:
# the facilitator settles USDC into X402_PAY_TO from the buyer's signature.

PORT=8080

# Required before /api/v1/probe or /api/v1/featured will accept payment.
# EVM address on the network below. There is no default.
X402_PAY_TO=

# Facilitator base URL (the process POSTs {base}/verify and {base}/settle).
# https://x402.org/facilitator is testnet-only. A mainnet facilitator is required to earn.
X402_FACILITATOR_URL=

# Optional bearer token, if that facilitator requires one. Never commit this.
X402_FACILITATOR_TOKEN=

# Defaults: Base mainnet and that chain's USDC.
X402_NETWORK=eip155:8453
# X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Atomic USDC units (6 decimals). 10000 = $0.01, 1000000 = $1.00.
X402_PROBE_AMOUNT=10000
X402_FEATURED_AMOUNT=1000000
X402_FEATURED_HOURS=168
X402_TIMEOUT_SECONDS=300

# Public origin used inside PAYMENT-REQUIRED, with no trailing slash.
X402_PUBLIC_URL=https://board.example

# Set to 1 when a reverse proxy sets X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=

CACHE_TTL_MS=300000
FREE_RATE_LIMIT=60
CATALOG_PATH=data/catalog.json
FEATURED_PATH=data/featured.json
