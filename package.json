  "license": "MIT",
  "bin": {
    "x402-priceboard": "bin/x402-priceboard.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "x402",
    "usdc",
    "base",
    "solana",
    "pricing",
    "agents",
    "micropayments",
    "crypto"
  ],
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rustemmustafingovua-byte/x402-priceboard.git"
  },
  "bugs": {
